#!/usr/bin/env bash

scriptPath="$(readlink -f ${BASH_SOURCE[0]:-$0})"
scriptDir="$(dirname "${scriptPath}")"
scriptName=${0##*/}
source "${scriptDir}/libxlvini"

fetchUpdate() {
    local scope="${scriptName}"

    if [[ $fetchUpdadeSig != 0 ]]; then
        sinf "Fetching updated repo.."
        apt update
    fi
}

upgrade() {
    local scope="${scriptName}-pkg"

    __upgrade() {
        echo ""
        sinf "Upgrading packages.."
        DEBIAN_FRONTEND=noninteractive apt upgrade $aptEarg && { [ "$cleanSig" -ne 1 ] && clean || return 0; }

    }
    fetchUpdate &&
        (__upgrade || (fixpkg && __upgrade))
    fixBootLink
}

distUpgrade() {
    local scope="${scriptName}"

    upgradeSig=0
    distUpgradeSub() {
        echo ""
        sinf "Upgrading distro.."
        DEBIAN_FRONTEND=noninteractive apt dist-upgrade $aptEarg && { [ "$cleanSig" -ne 1 ] && clean || return 0; }
    }
    salrt "Perfoming system wide upgrade.."
    fetchUpdate &&
        (distUpgradeSub || (fixpkg && distUpgradeSub))
    fixBootLink
}

inst_headers() {
    echo ""
    sinf "Installing headers.."
    (apt-cache show linux-headers-$(dpkg --print-architecture) 2>/dev/null && apt install -y linux-headers-$(dpkg --print-architecture) 2>/dev/null)
}

fixpkg() {
    echo ""
    local scope="${scriptName}-fix"

    sinf "Repairing any broken packages.."
    dpkg --configure -a $dpkgEarg
    apt --fix-missing --fix-broken install $aptEarg
}


clean() {
    local scope="${scriptName}-clean"

    if [[ $1 -ge 2 ]]; then
        echo ""
        sinf "Removing cache.."
        # completely empties the local repository of retrieved package files
        apt clean -y
    else
        echo ""
        sinf "Removing outdated cache.."
        # only deletes package files that can no longer be downloaded
        apt autoclean -y
    fi

    apt --purge autoremove -y
}

fixBootLink() {
    local scope="${scriptName}-boot"

    # Define the fixBoot function
    fixBoot() {
        bootDir="$1"
        cd "${bootDir}" || { wrn "" "Couldnt cd "${bootDir}".."; return 1; }
        echo ""
        sinf "Creating link to latest 'initrd.img, vmlinuz' in '/boot'.."
        # sort by version "ls -v" then catch last result "tail -n1"
        ln -svf "$(basename "$(ls -v "$bootDir"/initrd.img-* | tail -n1)")" initrd.img
        ln -svf "$(basename "$(ls -v "$bootDir"/vmlinuz-* | tail -n1)")" vmlinuz
    }

    # Set bootDir
    bootDir="/boot"

    # Check if bootDir exists and contains the necessary files
    if [[ -d "$bootDir" && $(ls "$bootDir"/vmlinuz-* 2>/dev/null) && $(ls "$bootDir"/initrd.img-* 2>/dev/null) ]]; then
        fixBoot "$bootDir" || return 1
    elif [[ "$bootDir" = "$HOME/../boot" && -d "$bootDir" && $(ls "$bootDir"/vmlinuz-* 2>/dev/null) && $(ls "$bootDir"/initrd.img-* 2>/dev/null) ]]; then
        fixBoot "$bootDir" || return 1
    elif [[ "$bootDir" = "$HOME/../../boot" && -d "$bootDir" && $(ls "$bootDir"/vmlinuz-* 2>/dev/null) && $(ls "$bootDir"/initrd.img-* 2>/dev/null) ]]; then
        fixBoot "$bootDir" || return 1
    else
        echo ""
        wrn "Couldnt update links to 'vmlinuz, initrd', no '/boot' dir.."
        return 1
    fi

    # Set fixBootLinkSig
    fixBootLinkSig=0
}
umount_tmpfs() {
    if [[ "$(findmnt -n -o FSTYPE /var/cache/apt)" != "tmpfs" ]]; then
        return 0
    fi
    local scope="${scriptName}-tmpfs"
    sinf "Unmounting tmpfs from ${m_dir}"
    umount -fl ${m_dir}
}
mount_tmpfs() {
    # local scope="${scriptName}-tmpfs"
    salrt "Mounting ${m_size} tmpfs on ${m_dir}"
    mount -t tmpfs -o size=${m_size} none ${m_dir}
    trap 'umount_tmpfs' EXIT INT TERM ERR
}

#--------------------FUNCTIONS-END--------------------
while getopts "xcCfhHklmMuUno" opt; do
    case $opt in
    # while [[ $# -gt 0 ]];do case $1 in
    h | --help) # usage
        echo -e "\nBe self-dependent !!"
        exit 0
        ;;
    x) #dont upgrade pkg
        fetchUpdadeSig=0; upgradeSig=0;;
    c) ((cleanSig++));;
    C) cleanSig=2;;
    f) fixpkgSig=1;;
    H) instHeaderSig=1;;
    k) kernFreeSig=1;;
    l) fixBootLinkSig=1;;
    m) mount_tmpfsSig=1;;
    M) mount_tmpfsSig=1; m_size=$2; shift;;
    u) upgradeSig=1;;
    U) distUpgradeSig=1;;
    n) # keep new conf files
        keepNewConf='-o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confnew"'
        dkeepNewConf='--force-confdef --force-confnew"'
        ;;
    o) # keep old conf files
        keepOldConf='-o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold"'
        dkeepOldConf='--force-confdef --force-confold"'
        ;;
    # --force-confold: do not modify the current configuration file, the new version is installed with a .dpkg-dist suffix. With this option alone, even configuration files that you have not modified are left untouched. You need to combine it with --force-confdef to let dpkg overwrite configuration files that you have not modified.
    # --force-confnew: always install the new version of the configuration file, the current version is kept in a file with the .dpkg-old suffix.
    # --force-confdef: ask dpkg to decide alone when it can and prompt otherwise. This is the default behavior of dpkg and this option is mainly useful in combination with --force-confold.
    # --force-confmiss: ask dpkg to install the configuration file if it’s currently missing (for example because you have removed the file by mistake).
    :)
        alrt "Error: Option $1 requires an argument."
        usage
        exit 1
        ;;
    *)
        alrt "Error: Invalid option $1"
        # usage
        exit 1
        ;;

    esac
    # shift
done
m_dir="${m_dir:-"/var/cache/apt"}"
m_size="${m_size:-"60%"}"
dpkgEarg="$dkeepOldConf $dkeepNewConf"
aptEarg="-y $keepOldConf $keepNewConf"

export DEBIAN_FRONTEND=noninteractive

# main function..
[ "${@:-0}" == '-x' ] && sinf "Nothing to.." && exit 0
(( ${mount_tmpfsSig:-0} )) && mount_tmpfs
(( ${distUpgradeSig:-0} )) && distUpgrade
(( ${upgradeSig:-0} )) && upgrade
(( ${kernFreeSig:-0} )) && (
    echo ""
    sinf "prepairing to remove old kernels.."
    kern-free -y
)
(( ${instHeaderSig:-0} )) && inst_headers
(( ${fixpkgSig:-0} )) && fixpkg
(( ${cleanSig:-0} )) && clean $cleanSig
(( ${fixBootLinkSig:-0} )) && fixBootLink
[ "${?}" -eq 0 ] && (smsg "$(date): upgrade successful") | (salrt "$(date): upgrade failed")
